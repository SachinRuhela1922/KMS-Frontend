# Backend (API) URL. No trailing slash.
# Local development: leave EMPTY (Vite proxies /api to http://localhost:5000)
# Production example: https://jgu-api.onrender.com
VITE_API_URL=https://kms-backend-ve6e.onrender.com/

# Static copy of the content, used when the backend is off / asleep.
# Local: leave EMPTY (uses /content.json from public/, written by the backend on every save)
# Production: paste the "Content backup URL" shown in Admin -> Dashboard, e.g.
#   https://res.cloudinary.com/<cloud>/raw/upload/jgu/site-content.json
VITE_CONTENT_URL=
